        BEGIN
            VALUE "CompanyName", "7-Zip Helper"
            VALUE "FileDescription", "7-Zip Windows 11 Modern Context Menu Extension"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "SevenZipContextMenu.dll"
            VALUE "LegalCopyright", "Open Source"
            VALUE "OriginalFilename", "SevenZipContextMenu.dll"
            VALUE "ProductName", "7-Zip Modern Context Menu"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
